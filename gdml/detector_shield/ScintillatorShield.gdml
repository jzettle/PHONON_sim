<?xml version="1.0" encoding="UTF-8" ?>
<gdml xmlns:gdml="http://cern.ch/2001/Schemas/GDML" 
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="../schema/gdml.xsd" >

  <define>
    <!-- Constants --> 
    <constant name="TWOPI" value="2.0*pi" />
    <constant name="pmtrad" value="4.0*2.54" />
    <constant name="PI" value="1.0*pi" />
    <constant name="HALFPI" value="0.5*pi" />
    <!-- Quantities -->
    <quantity name="world_x" value="5000.0" unit="mm" />
    <quantity name="world_y" unit="mm" value="5000.0" />
    <quantity name="world_z" unit="mm" value="5000.0" />
    <!-- Positions -->
    <position name="scintPos" unit="m" x="-0.25" y="0.0" z="0.0" /> 
    <position name="airPos" unit="m" x="0.15" y="0.0" z="0.0" />
    <position name="waterShieldPos" unit="m" x="0.0" y="0.0" z="0.0" />
    <position name="shieldPos" unit="m" x="0.0" y="0.0" z="0.0" />
    <position name="PMTPos2" unit="m" x="-0.140" y="0.0" z="0.0" />
    <position name="PMTPos1" unit="m" x="-0.062" y="0.0" z="0.0" /> 
    <!--<position name="targetPos" unit="m" x="0.75" y="0.0" z="0.0" /> 
    <position name="shieldPos" unit="m" x="1.25" y="0.0" z="0.0" /> 
    <position name="steelPos" unit="m" x="1.75" y="0.0" z="0.0" /> -->
    <position name="scintSub" unit="m" x="-0.15" y="0.0" z="0.0" />
    <position name="sensorSub" unit="m" x="-0.13" y="0.0" z="0.0" />
    <position name="waterShieldSub" unit="m" x="0.15" y="0.0" z="0.0" />
    <!--<position name="cuSub" unit="m" x="-0.50" y="0.0" z="0.0" />
    <position name="steelSub" unit="m" x="-0.50" y="0.0" z="0.0" /> -->
    <position name="shieldSub" unit="m" x="0.0" y="0.0" z="0.0" />
    <position name="PMTSum" unit="m" x="0.127" y="0.0" z="0.0" />
    <!-- old x pos -1.8 -1.55 -1.05 -0.55, shift by 2.05 m so edge is at 0-->
    <!-- <position name="targetPos" unit="m" x="-3.5975" y="0.0" z="0.0" /> -->
    <rotation name="rotScint" unit="deg" x="90.0" y="90.0" z="0.0" />
    <rotation name="rotScint2" unit="deg" x="180.0" y="180.0" z="0.0" />
  </define>

  <materials>
    <element name="Hydrogen" formula="H" Z="1."> <atom value="1.01"/>
    </element>
    <element name="Oxygen" formula="O" Z="8."> <atom value="16.0"/>
    </element>
    <element name="Nitrogen" formula="N" Z="7."> <atom value="14.01"/>
    </element>
    <element name="Carbon" formula="C" Z="6."> <atom value="12.01"/>
    </element>
    <element name="Fluorine" formula="F" Z="9"> <atom value="18.00"/>
    </element>
    <element name="Argon" formula="Ar" Z="18."> <atom value="39.95"/>
    </element>
    <element name="Copper" formula="Cu" Z="29"> <atom value="63.546"/>
    </element>
    <element name="Lead" formula="Pb" Z="82"> <atom value="207.2"/>
    </element>
    <element name="Lithium" formula="Li" Z="3"> <atom value="6.94"/>
    </element>
    <element name="Niobium" formula="Nb" Z="41"> <atom value="92.906"/>
    </element>
    <element name="Silicon" formula="Si" Z="14"> <atom value="28.085"/>
    </element>
    <element name="Boron10" formula="B" Z="5"> <atom value="10"/>
    </element>
    <element name="Iron" formula="Fe" Z="26"> <atom value="55.845"/>
    </element>
    <element name="Chromium" formula="Cr" Z="24"> <atom value="51.9961"/>
    </element>
    <element name="Nickel" formula="Ni" Z="28"> <atom value="58.6934"/>
    </element>
    <material name="Air"> 
      <D value="1.290" unit="mg/cm3"/>
      <fraction n="0.7" ref="Nitrogen"/>
      <fraction n="0.3" ref="Oxygen"/>
    </material>
    <material name="Graphite">
      <D value="1.78" unit="g/cm3"/>
      <composite n="1" ref="Carbon"/>
    </material>
    <material name="liquidArgon" formula="LAr">
      <D value="1.4" unit="g/cm3"/>
      <composite n="1" ref="Argon"/>
    </material>
    <material name="PTFE">
      <D value="2.2" unit="g/cm3"/>
      <composite n="2" ref="Carbon"/>
      <composite n="4" ref="Fluorine"/>
    </material>
    <material name="Copper">
      <D value="8.96" unit="g/cm3"/>
      <composite n="1" ref="Copper"/>
    </material>
    <material name="Lead">
      <D value="11.34" unit="g/cm3"/>
      <composite n="1" ref="Lead"/>
    </material>
    <material name="SS">
      <D value="7.5" unit="g/cm3"/>
      <fraction n="0.72" ref="Iron"/>
      <fraction n="0.17" ref="Chromium"/>
      <fraction n="0.11" ref="Nickel"/>
    </material>
    <!-- Material concentration of EJ-309B-1% scintillator with fractional components -->
    <material name="Scintillator">
      <D value="0.965" unit="g/cm3"/>
      <fraction n="0.443" ref="Carbon"/>
      <fraction n="0.556" ref="Hydrogen"/>
      <fraction n="0.001" ref="Boron10"/>
    </material>
    <material name="Vacuum">
      <D value="1.0e-25" unit="g/cm3"/>
      <fraction n="0.7" ref="Nitrogen"/>
      <fraction n="0.3" ref="Oxygen"/>
    </material>
    <material name="LiNbO3">
      <D value="4.64" unit="g/cm3"/>
      <composite n="1" ref="Lithium"/>
      <composite n="1" ref="Niobium"/>
      <composite n="3" ref="Oxygen"/>
    </material>
    <material name="Water">
      <D value="1.0" unit="g/cm3"/>
      <composite n="2" ref="Hydrogen"/>
      <composite n="1" ref="Oxygen"/>
    </material>
    <material name="SiC">
      <D value="3.16" unit="g/cm3"/>
      <composite n="1" ref="Silicon"/>
      <composite n="1" ref="Carbon"/>
    </material> 
  </materials>  
  
  <solids>
    <box name="WorldSolid" lunit="mm" x="5000.0" y="5000.0" z="5000.0" />
    <!-- z is the "beam direction here"-->
    <!--<box name="ScintillatorSolid" lunit="mm" x="40.0" y="40.0" z="40.0" /> -->
    <!-- Liquid Scintillator detector is 5x5" cylinder of LS-->
    <tube name="ScintillatorSolid" lunit="mm" rmin="0.0" rmax="63.5" z="127.0" deltaphi="360" aunit="deg" />
    <tube name="HousingSolid" lunit="mm" rmin="63.5" rmax="65.0" z="130.0" deltaphi="360" aunit="deg" />
    <tube name="PMTSolidVac" lunit="mm" rmin="0.0" rmax="57.15" z="89.0" deltaphi="360" aunit="deg"/>
    <tube name="PMTStalkVac" lunit="mm" rmin="0.0" rmax="19.40" z="66.0" deltaphi="360" aunit="deg" />
    <tube name="PMTSolidSteel" lunit="mm" rmin="57.15" rmax="63.5" z="89.0" deltaphi="360" aunit="deg"/>
    <tube name="PMTStalkSteel" lunit="mm" rmin="19.40" rmax="25.75" z="66.0" deltaphi="360" aunit="deg" />
    <box name="SensorSolid" lunit="mm" x="5.0" y="40.0" z="40.0" />
    <box name="AirSolid" lunit="mm" x="700.0" y="400.0" z="400.0" />
    <!--<box name="TargetSolid" lunit="mm" x="1500.0" y="200.0" z="200.0" /> -->
    <box name="WaterShieldSolid" lunit="mm" x="800.0" y="800.0" z="800.0" />
    <box name="LeadShieldSolid" lunit="mm" x="1000.0" y="1000.0" z="1000.0" />
    <box name="NeutronPlaneSolid" lunit="mm" x="1002.0" y="1002.0" z="1002.0" />
    <box name="NeutronPlaneSolid2" lunit="mm" x="1004.0" y="1004.0" z="1004.0" />

    <subtraction name="NeutronPlaneCavity">
      <first ref="NeutronPlaneSolid2"/>
      <second ref="NeutronPlaneSolid"/>
      <positionref ref="shieldSub" />
    </subtraction>  

    <subtraction name="WaterShieldCavity">
      <first ref="WaterShieldSolid"/>
      <second ref="AirSolid"/>
      <positionref ref="waterShieldSub" />
    </subtraction>

    <subtraction name="FullShieldCavity">
      <first ref="LeadShieldSolid" />
      <second ref="WaterShieldSolid" />
      <positionref ref="shieldSub" />
    </subtraction>

  </solids>
  <structure>
   
    <volume name="ScintLog">
      <materialref ref="Scintillator" />
      <solidref ref="ScintillatorSolid" />
    </volume>

    <volume name="HousingLog">
      <materialref ref="SS" />
      <solidref ref="HousingSolid" />
    </volume>

     <volume name="PMTLog1">
      <materialref ref="Vacuum" />
      <solidref ref="PMTStalkVac"/>
    </volume>


     <volume name="PMTLog2">
      <materialref ref="Vacuum" />
      <solidref ref="PMTSolidVac"/>
     </volume>

     <volume name="PMTLog3">
      <materialref ref="SS" />
      <solidref ref="PMTStalkSteel"/>
    </volume>


     <volume name="PMTLog4">
      <materialref ref="SS" />
      <solidref ref="PMTSolidSteel"/>
    </volume>

    <volume name="AirLog">
      <materialref ref="Vacuum" />
      <solidref ref="AirSolid" />
      <physvol name="ScintillatorVol" >
      <volumeref ref="ScintLog" />
        <positionref ref="scintPos" />
        <rotationref ref="rotScint" />
      </physvol>

      <physvol name="HousingVol" >
      <volumeref ref="HousingLog" />
      <positionref ref="scintPos" />
      <rotationref ref="rotScint" />
      </physvol>

      <physvol name="PMTVol1" >
	<volumeref ref="PMTLog1"/>
	<positionref ref="PMTPos1"/>
	<rotationref ref="rotScint"/>
      </physvol>
      
      <physvol name="PMTVol2" >
        <volumeref ref="PMTLog2"/>
        <positionref ref="PMTPos2"/>
        <rotationref ref="rotScint"/>
      </physvol>

      <physvol name="PMTVol3" >
        <volumeref ref="PMTLog3"/>
        <positionref ref="PMTPos1"/>
	<rotationref ref="rotScint"/>
      </physvol>

      <physvol name="PMTVol4" >
        <volumeref ref="PMTLog4"/>
	<positionref ref="PMTPos2"/>
        <rotationref ref="rotScint"/>
      </physvol>
    </volume> 
 
    <volume name="WaterShieldLog">
      <materialref ref="Water" />
      <solidref ref="WaterShieldCavity" />
    </volume>
    
    <volume name="FullShieldLog">
      <materialref ref="Lead" />
      <solidref ref="FullShieldCavity" />
    </volume> 

    <volume name="NeutronPlaneLog">
      <materialref ref="Vacuum" />
      <solidref ref="NeutronPlaneCavity" />
    </volume>

    <volume name="World" >
      <materialref ref="Vacuum" />
      <solidref ref="WorldSolid" />

      <physvol name="AirVol" >
  <volumeref ref="AirLog" />
  <positionref ref="airPos" />
    </physvol> 

      <physvol name="WaterShieldVol" >
	<volumeref ref="WaterShieldLog" />
	<positionref ref="waterShieldPos" />
      </physvol>
      
      <physvol name="FullShieldVol" >
	<volumeref ref="FullShieldLog" />
	<positionref ref="shieldPos" />
      </physvol>

      <physvol name="NeutronPlaneVol" >
  <volumeref ref="NeutronPlaneLog" />
  <positionref ref="shieldPos" />
    </physvol>
     
    </volume>
  </structure>

  <setup name="WorldVol" version="1.0">
    <world ref="World"/>
  </setup>
</gdml>
   
		          
